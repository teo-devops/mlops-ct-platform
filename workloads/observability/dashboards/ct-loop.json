{
 "title": "CT Loop",
 "uid": "ct-loop",
 "tags": [
  "mlops-ct-platform"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "use_case",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(ct_drift_psi, use_case)",
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Model monitoring \u2014 drift (PSI: training reference vs live window)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "PSI per column \u2014 $use_case",
   "gridPos": {
    "h": 9,
    "w": 16,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ct_drift_psi{use_case=~\"$use_case\"}",
     "legendFormat": "{{model}} \u00b7 {{column}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.2
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line+area"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Max PSI per model",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (model) (ct_drift_psi{use_case=~\"$use_case\"})",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.2
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Retrain triggered (last run)",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ct_drift_detected{use_case=~\"$use_case\"}",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Rows in window",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ct_drift_window_rows{use_case=~\"$use_case\"}",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Monitor freshness (s since last run)",
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 0,
    "y": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - ct_drift_last_run_timestamp_seconds{use_case=~\"$use_case\"}",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 900
       },
       {
        "color": "red",
        "value": 1800
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "id": 7,
   "type": "row",
   "title": "Pipelines (Argo Workflows)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "collapsed": false
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Workflows by phase",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 15
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (phase) (argo_workflows_gauge)",
     "legendFormat": "{{phase}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Pipeline runs (rate, 1h)",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 15
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (increase(argo_workflows_workflowtemplate_triggered_total[1h]))",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "row",
   "title": "Serving \u2014 the synchronous path",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 22
   },
   "collapsed": false
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Requests / s",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 23
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (use_case) (rate(uc_requests_total{use_case=~\"$use_case\"}[5m]))",
     "legendFormat": "{{use_case}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "API latency p50 / p95 / p99",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 23
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/v1/.*\"}[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/v1/.*\"}[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/v1/.*\"}[5m])))",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Upstream model latency p99",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 23
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le, model) (rate(uc_upstream_latency_seconds_bucket{use_case=~\"$use_case\"}[5m])))",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Fallback ratio (answers by rules / requests)",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 30
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(uc_fallback_total{use_case=~\"$use_case\"}[5m])) / sum(rate(uc_requests_total{use_case=~\"$use_case\"}[5m]))",
     "legendFormat": "fallback ratio"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.05
       },
       {
        "color": "red",
        "value": 0.2
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line+area"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Served model versions (predictions / s)",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 30
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model, model_version) (rate(uc_predictions_total{use_case=~\"$use_case\", source=\"model\"}[5m]))",
     "legendFormat": "{{model}} v{{model_version}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 16,
   "type": "stat",
   "title": "Circuit breaker (0 closed \u00b7 1 half-open \u00b7 2 open)",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 30
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "uc_circuit_state{use_case=~\"$use_case\"}",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "5xx ratio",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 37
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{handler=~\"/v1/.*\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{handler=~\"/v1/.*\"}[5m]))",
     "legendFormat": "5xx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Prediction-log records flushed / s",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 12,
    "y": 37
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (rate(uc_prediction_log_records_total{use_case=~\"$use_case\"}[5m]))",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}